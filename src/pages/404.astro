---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';

const seoTitle = 'Página no encontrada — Spendly';
const seoDescription = 'La página que buscas no existe o ha sido movida. Vuelve al inicio de Spendly.';
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <section class="py-24 sm:py-32 flex items-center justify-center min-h-[60vh]">
    <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-16 h-16 rounded-2xl bg-spendly-100 text-spendly-700 flex items-center justify-center mx-auto mb-6 border border-spendly-200">
        <span class="text-2xl font-extrabold">404</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-content-primary">
        No encontramos esta página.
      </h1>

      <p class="mt-4 text-base sm:text-lg text-content-secondary max-w-md mx-auto leading-relaxed">
        El enlace que intentas abrir no existe o ha sido movido. Pero no te preocupes, tus finanzas siguen estando en su lugar.
      </p>

      <div class="mt-8 flex justify-center">
        <Button href="/" size="lg" variant="primary">
          Volver al inicio
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
