---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { allFaqs } from '../data/faq';
import { getAppUrl } from '../data/navigation';

const registerUrl = getAppUrl('registro');

const categories = [
  { id: 'general', label: 'General' },
  { id: 'funciones', label: 'Funciones' },
  { id: 'planes', label: 'Planes y Precios' },
  { id: 'seguridad', label: 'Seguridad' },
];

const seoTitle = 'Preguntas Frecuentes — Spendly | Centro de Ayuda';
const seoDescription = 'Respuestas a todas las preguntas frecuentes sobre Spendly: registro, uso de cuentas, presupuestos, metas, seguridad y planes disponibles.';
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <!-- Hero de Preguntas -->
  <section class="py-16 sm:py-24 bg-surface-bg border-b border-surface-border">
    <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <Badge variant="mint" class="mb-4">Centro de Preguntas</Badge>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-content-primary max-w-3xl mx-auto leading-[1.15]">
        ¿Tienes dudas? <span class="spendly-gradient-text">Aquí te respondemos.</span>
      </h1>
      <p class="mt-6 text-lg text-content-secondary max-w-2xl mx-auto leading-relaxed">
        Encuentra respuestas claras y directas sobre cómo funciona Spendly, qué incluye cada plan y cómo protegemos tu información.
      </p>
    </div>
  </section>

  <!-- Preguntas agrupadas por categoría -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <div class="space-y-16">
        {categories.map((cat) => {
          const categoryFaqs = allFaqs.filter((f) => f.category === cat.id);
          return (
            <div id={cat.id} class="space-y-6">
              <div class="border-b border-surface-border pb-3 flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-spendly-500"></span>
                <h2 class="text-2xl font-bold text-content-primary tracking-tight">
                  {cat.label}
                </h2>
              </div>

              <div class="space-y-4">
                {categoryFaqs.map((faq) => (
                  <details class="group rounded-2xl border border-surface-border bg-surface-cardSubtle transition-all duration-200 open:bg-white open:shadow-soft-md open:border-spendly-200">
                    <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer list-none select-none rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-spendly-500">
                      <h3 class="text-base sm:text-lg font-semibold text-content-primary pr-4">
                        {faq.question}
                      </h3>
                      <div class="w-8 h-8 rounded-lg bg-spendly-100 text-spendly-700 flex items-center justify-center shrink-0 transition-transform duration-200 group-open:rotate-180 border border-spendly-200">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                      </div>
                    </summary>
                    <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-1 text-sm sm:text-base text-content-secondary leading-relaxed border-t border-surface-borderSubtle mt-1">
                      <p>{faq.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Sección de soporte -->
      <div id="contacto" class="mt-20 p-8 sm:p-10 rounded-3xl bg-spendly-50 border border-spendly-200 text-center">
        <h3 class="text-2xl font-bold text-content-primary">
          ¿No encontraste la respuesta que buscabas?
        </h3>
        <p class="mt-3 text-sm sm:text-base text-content-secondary max-w-xl mx-auto">
          Estamos comprometidos a ofrecerte la mejor experiencia posible. Puedes crear tu cuenta gratuita para explorar la plataforma o escribirnos a nuestro canal de soporte.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row justify-center items-center gap-4">
          <Button href={registerUrl} size="md" variant="primary">
            Crear cuenta gratis
          </Button>
          <Button href="mailto:soporte@spendly.app" size="md" variant="outline" isExternal={true}>
            Contactar a soporte
          </Button>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
