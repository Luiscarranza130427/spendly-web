---
import { mainNavItems, getAppUrl } from '../../data/navigation';
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;
const loginUrl = getAppUrl('login');
const registerUrl = getAppUrl('registro');
---

<header
  id="main-navbar"
  class="sticky top-0 z-40 w-full transition-all duration-200 border-b border-surface-border/60 bg-surface-bg/85 backdrop-blur-md"
>
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo de Spendly -->
      <a
        href="/"
        class="flex items-center group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-spendly-500 rounded-lg p-1"
        aria-label="Spendly — Volver a la página de inicio"
      >
        <img
          src="/images/brand/spendly-logo-optimized.webp"
          alt="Spendly — Todo tu dinero. Un solo lugar."
          width="140"
          height="50"
          class="h-8 sm:h-9 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
        />
      </a>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Navegación principal">
        {
          mainNavItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors duration-150 ${
                  isActive
                    ? 'text-spendly-700 bg-spendly-100 font-semibold'
                    : 'text-content-secondary hover:text-content-primary hover:bg-surface-cardSubtle'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Botones de Acción Desktop -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href={loginUrl}
          class="text-sm font-medium text-content-secondary hover:text-content-primary px-3.5 py-2 rounded-lg transition-colors"
        >
          Iniciar sesión
        </a>
        <Button href={registerUrl} size="sm" variant="primary">
          Empieza gratis
        </Button>
      </div>

      <!-- Botón Hamburguesa Mobile -->
      <div class="flex items-center md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="inline-flex items-center justify-center p-2 rounded-lg text-content-secondary hover:text-content-primary hover:bg-surface-cardSubtle focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-spendly-500"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú de navegación"
        >
          <svg
            id="hamburger-icon"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg
            id="close-icon"
            class="w-6 h-6 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú Desplegable Mobile -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-b border-surface-border bg-white shadow-soft-lg transition-all duration-200"
  >
    <div class="px-4 pt-3 pb-6 space-y-2">
      <nav class="space-y-1" aria-label="Navegación móvil">
        {
          mainNavItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`block px-3.5 py-2.5 rounded-xl text-base font-medium transition-colors ${
                  isActive
                    ? 'text-spendly-700 bg-spendly-100 font-semibold'
                    : 'text-content-secondary hover:text-content-primary hover:bg-surface-cardSubtle'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <div class="pt-4 border-t border-surface-borderSubtle flex flex-col gap-2.5">
        <a
          href={loginUrl}
          class="w-full text-center py-2.5 text-base font-medium text-content-primary hover:bg-surface-cardSubtle rounded-xl transition-colors"
        >
          Iniciar sesión
        </a>
        <Button href={registerUrl} size="md" variant="primary" class="w-full text-center">
          Empieza gratis
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const navbar = document.getElementById('main-navbar');

    if (!button || !menu || !hamburgerIcon || !closeIcon) return;

    const btn = button;
    const mn = menu;
    const hIcon = hamburgerIcon;
    const cIcon = closeIcon;

    function toggleMenu() {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      btn.setAttribute('aria-label', !isExpanded ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      mn.classList.toggle('hidden');
      hIcon.classList.toggle('hidden');
      cIcon.classList.toggle('hidden');

      if (!isExpanded) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    }

    function closeMenu() {
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Abrir menú de navegación');
      mn.classList.add('hidden');
      hIcon.classList.remove('hidden');
      cIcon.classList.add('hidden');
      document.body.style.overflow = '';
    }

    btn.addEventListener('click', toggleMenu);

    // Cerrar al presionar Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        btn.focus();
      }
    });

    // Cerrar al hacer clic en enlaces del menú móvil
    const links = mn.querySelectorAll('a');
    links.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Efecto sutil al hacer scroll
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        navbar?.classList.add('bg-white/95', 'shadow-soft-sm');
        navbar?.classList.remove('bg-surface-bg/85');
      } else {
        navbar?.classList.remove('bg-white/95', 'shadow-soft-sm');
        navbar?.classList.add('bg-surface-bg/85');
      }
    }, { passive: true });
  }

  // Inicializar al cargar el DOM
  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>
