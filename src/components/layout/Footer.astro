---
import { footerNavigation, getAppUrl } from '../../data/navigation';

const currentYear = new Date().getFullYear();
const loginUrl = getAppUrl('login');
const registerUrl = getAppUrl('registro');
---

<footer class="border-t border-surface-border bg-white mt-auto">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 lg:gap-12">
      <!-- Columna Principal / Marca -->
      <div class="col-span-2">
        <a href="/" class="inline-flex items-center group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-spendly-500 rounded-lg">
          <img
            src="/images/brand/spendly-logo-original.webp"
            alt="Spendly"
            width="140"
            height="50"
            class="h-8 sm:h-9 w-auto object-contain"
          />
        </a>

        <p class="mt-4 text-sm text-content-secondary max-w-sm leading-relaxed">
          La plataforma para organizar tus cuentas, movimientos, presupuestos y metas de ahorro con una experiencia simple, visual y privada.
        </p>

        <div class="mt-6">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-spendly-50 text-spendly-700 border border-spendly-200">
            Spendly by NovaTec
          </span>
        </div>
      </div>

      <!-- Columna: Producto -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-content-primary mb-4">
          Producto
        </h4>
        <ul class="space-y-2.5">
          {
            footerNavigation.producto.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-content-secondary hover:text-spendly-600 transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna: Cuenta & Ayuda -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-content-primary mb-4">
          Cuenta
        </h4>
        <ul class="space-y-2.5 mb-6">
          <li>
            <a href={loginUrl} class="text-sm text-content-secondary hover:text-spendly-600 transition-colors">
              Iniciar sesión
            </a>
          </li>
          <li>
            <a href={registerUrl} class="text-sm text-content-secondary hover:text-spendly-600 transition-colors">
              Crear cuenta
            </a>
          </li>
        </ul>

        <h4 class="text-xs font-bold uppercase tracking-wider text-content-primary mb-4">
          Ayuda
        </h4>
        <ul class="space-y-2.5">
          {
            footerNavigation.ayuda.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-content-secondary hover:text-spendly-600 transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna: Legal -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-content-primary mb-4">
          Legal
        </h4>
        <ul class="space-y-2.5">
          {
            footerNavigation.legal.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-content-secondary hover:text-spendly-600 transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Barra Inferior de Derechos -->
    <div class="mt-12 pt-8 border-t border-surface-borderSubtle flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-content-muted">
      <p>© {currentYear} Spendly by NovaTec. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1">
        <span>Diseñado para tu bienestar financiero personal.</span>
      </p>
    </div>
  </div>
</footer>
