---
const values = [
  {
    title: 'Simple',
    description: 'Sin configuraciones abrumadoras ni hojas de cálculo que se rompen.',
    icon: 'Sparkles',
  },
  {
    title: 'Seguro',
    description: 'Sesiones protegidas, cifrado HTTPS y aislamiento estricto por usuario.',
    icon: 'ShieldCheck',
  },
  {
    title: 'Organizado',
    description: 'Tus cuentas, movimientos, presupuestos y metas sincronizados.',
    icon: 'Layers',
  },
];
---

<section class="border-y border-surface-border bg-white/70 py-10">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      {values.map((v) => (
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-spendly-100 text-spendly-700 flex items-center justify-center shrink-0 border border-spendly-200">
            {v.icon === 'Sparkles' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            )}
            {v.icon === 'ShieldCheck' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {v.icon === 'Layers' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            )}
          </div>
          <div>
            <h3 class="text-base font-bold text-content-primary tracking-tight">
              {v.title}
            </h3>
            <p class="mt-1 text-sm text-content-secondary leading-relaxed">
              {v.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
