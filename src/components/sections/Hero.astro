---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import { getAppUrl } from '../../data/navigation';

const registerUrl = getAppUrl('registro');
---

<section class="relative pt-8 pb-16 sm:pt-14 sm:pb-24 lg:pt-20 lg:pb-32 overflow-hidden">
  <!-- Fondo decorativo suave -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute -top-40 right-1/4 w-96 h-96 bg-spendly-100/60 rounded-full blur-3xl opacity-70"></div>
    <div class="absolute top-1/3 -left-20 w-80 h-80 bg-spendly-200/40 rounded-full blur-3xl opacity-60"></div>
  </div>

  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Columna Izquierda: Copy de Conversión -->
      <div class="lg:col-span-6 xl:col-span-6 flex flex-col items-start text-left" data-reveal>
        <div class="mb-5">
          <Badge variant="mint" dot={true}>
            Finanzas Personales Simples
          </Badge>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-content-primary leading-[1.12]">
          Todo tu dinero.<br />
          <span class="spendly-gradient-text">Un solo lugar.</span>
        </h1>

        <p class="mt-6 text-base sm:text-lg text-content-secondary leading-relaxed max-w-xl font-normal">
          Controla tus ingresos, gastos, cuentas, presupuestos y metas de forma sencilla, visual y organizada con Spendly.
        </p>

        <!-- Botones de Acción -->
        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 w-full sm:w-auto">
          <Button href={registerUrl} size="lg" variant="primary" class="w-full sm:w-auto text-center shadow-soft-lg">
            Empieza gratis
            <svg class="w-5 h-5 ml-1 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </Button>

          <Button href="#funciones" size="lg" variant="outline" class="w-full sm:w-auto text-center">
            Ver cómo funciona
          </Button>
        </div>

        <!-- Micro-beneficios transparentes -->
        <div class="mt-8 pt-6 border-t border-surface-borderSubtle flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-content-secondary">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-spendly-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Plan gratuito activo</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-spendly-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Sin datos de tarjeta</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-spendly-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Acceso web privado</span>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Mockup Protagonista con Composición Premium -->
      <div class="lg:col-span-6 xl:col-span-6 relative flex justify-center lg:justify-end">
        <div class="relative w-full max-w-lg lg:max-w-none">
          <!-- Tarjeta de mockup principal con efecto 3D -->
          <div class="relative rounded-2xl sm:rounded-3xl p-2 sm:p-3 bg-white/90 backdrop-blur-sm border border-surface-border shadow-soft-xl transition-all duration-300 hover:shadow-card-hover tilt-3d">
            <img
              src="/images/illustrations/hero-fintech.webp"
              alt="Ilustración principal de Spendly mostrando organización financiera, cuentas e inversiones en un solo lugar."
              width="640"
              height="440"
              class="w-full h-auto rounded-xl sm:rounded-2xl object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <!-- Card flotante interactiva: Balance Consolidado -->
          <div class="hidden sm:flex absolute -bottom-5 -left-4 sm:-bottom-6 sm:-left-6 bg-white rounded-2xl p-4 shadow-soft-lg border border-surface-border items-center gap-3.5 z-10 animate-float-slow">
            <div class="w-10 h-10 rounded-xl bg-spendly-100 text-spendly-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-content-secondary">Balance consolidado</p>
              <p class="text-base font-bold text-content-primary tracking-tight">Todas tus cuentas</p>
            </div>
          </div>

          <!-- Card flotante interactiva: Metas en Progreso -->
          <div class="hidden sm:flex absolute -top-4 -right-4 sm:-top-5 sm:-right-5 bg-white rounded-2xl p-3.5 shadow-soft-lg border border-surface-border items-center gap-3 z-10">
            <div class="w-8 h-8 rounded-lg bg-spendly-500 text-white flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div class="pr-2">
              <p class="text-xs font-bold text-content-primary">Meta de Ahorro</p>
              <p class="text-xs text-spendly-600 font-semibold">En progreso visible</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
