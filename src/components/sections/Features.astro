---
import SectionTitle from '../ui/SectionTitle.astro';
import FeatureCard from '../ui/FeatureCard.astro';
import FeaturesCarousel from '../ui/FeaturesCarousel.astro';
import { coreFeatures } from '../../data/features';
---

<section id="funciones" class="py-16 sm:py-24 bg-surface-bg">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle
      badge="Funcionalidades"
      title="Herramientas simples para"
      highlightText="controlar tu dinero"
      subtitle="Spendly te da las herramientas exactas para organizar tu día a día financiero sin complejidades innecesarias."
      align="center"
    />

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {coreFeatures.map((feat) => (
        <FeatureCard
          title={feat.title}
          tagline={feat.tagline}
          description={feat.description}
          highlights={feat.highlights}
        >
          <div slot="icon">
            {feat.id === 'cuentas' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
              </svg>
            )}
            {feat.id === 'movimientos' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
            )}
            {feat.id === 'analisis' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            )}
            {feat.id === 'presupuestos' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
              </svg>
            )}
            {feat.id === 'metas' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            {feat.id === 'recurrentes' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            )}
          </div>

          <div slot="footer">
            <a
              href={`/funciones#${feat.id}`}
              class="inline-flex items-center text-xs font-semibold text-spendly-600 hover:text-spendly-700 transition-colors group"
            >
              Conocer más de {feat.title.toLowerCase()}
              <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </FeatureCard>
      ))}
    </div>

    <!-- Carrusel Interactivo 3D -->
    <div class="mt-16 pt-8 border-t border-surface-borderSubtle">
      <div class="text-center mb-4">
        <h3 class="text-xl sm:text-2xl font-bold text-content-primary">
          O explora cada herramienta en detalle
        </h3>
        <p class="text-xs sm:text-sm text-content-secondary mt-1">
          Navegación interactiva con demostraciones visuales y animaciones
        </p>
      </div>
      <FeaturesCarousel />
    </div>
  </div>
</section>
