---
import Badge from '../ui/Badge.astro';
---

<section id="multidispositivo" class="py-16 sm:py-24 bg-surface-bg">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Columna Visual Izquierda -->
      <div class="lg:col-span-6 order-2 lg:order-1 flex justify-center">
        <div class="w-full max-w-lg rounded-2xl sm:rounded-3xl p-3 bg-white border border-surface-border shadow-soft-lg">
          <img
            src="/images/illustrations/multidevice.png"
            alt="Spendly adaptado a pantallas de escritorio, tablets y dispositivos móviles a través del navegador web."
            width="560"
            height="380"
            class="w-full h-auto rounded-xl sm:rounded-2xl object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Columna Texto Derecha -->
      <div class="lg:col-span-6 order-1 lg:order-2 flex flex-col items-start">
        <div class="mb-3">
          <Badge variant="mint">Experiencia Web Fluida</Badge>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-content-primary leading-[1.18]">
          Siempre contigo,<br />
          <span class="spendly-gradient-text">en todos tus dispositivos.</span>
        </h2>

        <p class="mt-5 text-base sm:text-lg text-content-secondary leading-relaxed">
          Consulta Spendly desde tu laptop, tablet o teléfono con una experiencia web responsiva adaptada con precisión a cada pantalla.
        </p>

        <div class="mt-8 space-y-4 w-full">
          <div class="flex items-start gap-3.5">
            <div class="w-8 h-8 rounded-lg bg-spendly-100 text-spendly-700 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-content-primary">Desde tu navegador favorito</h3>
              <p class="text-xs sm:text-sm text-content-secondary mt-0.5">Sin necesidad de descargar apps pesadas de tiendas de aplicaciones. Accede desde cualquier navegador moderno al instante.</p>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="w-8 h-8 rounded-lg bg-spendly-100 text-spendly-700 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-content-primary">Diseño optimizado para cada tamaño</h3>
              <p class="text-xs sm:text-sm text-content-secondary mt-0.5">Vistas condensadas y accesibles en móvil para registro rápido, y paneles amplios en escritorio para análisis detallados.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
