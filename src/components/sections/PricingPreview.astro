---
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';
import { plans } from '../../data/pricing';
import { getAppUrl } from '../../data/navigation';

const registerUrl = getAppUrl('registro');
---

<section id="planes" class="py-16 sm:py-24 bg-surface-bg">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle
      badge="Planes y Precios Oficiales"
      title="Planes transparentes,"
      highlightText="sin comisiones ocultas"
      subtitle="Comienza con lo esencial sin costo o lleva tu gestión financiera al siguiente nivel con Spendly Pro."
      align="center"
    />

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto items-stretch">
      {plans.map((plan) => (
        <div
          class={`spendly-card rounded-2xl p-7 sm:p-9 flex flex-col justify-between relative bg-white transition-all duration-300 hover:shadow-card-hover ${
            plan.id === 'pro'
              ? 'border-2 border-spendly-500 shadow-soft-xl'
              : 'border border-surface-border shadow-soft'
          }`}
        >
          <div>
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                {plan.id === 'pro' && (
                  <svg class="w-5 h-5 text-spendly-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                  </svg>
                )}
                <h3 class="text-2xl sm:text-3xl font-extrabold text-content-primary">
                  {plan.name}
                </h3>
              </div>

              {plan.id === 'gratis' ? (
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-spendly-700 text-white">
                  Tu plan
                </span>
              ) : (
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-spendly-100 text-spendly-700">
                  Recomendado
                </span>
              )}
            </div>

            <p class="text-sm text-content-secondary leading-relaxed mb-6">
              {plan.tagline}
            </p>

            <div class="mb-6 pb-6 border-b border-surface-borderSubtle">
              <div class="flex items-baseline gap-1.5">
                <span class="text-3xl font-black text-content-primary">
                  {plan.currency}/
                </span>
                <span class="text-5xl font-black text-content-primary tracking-tight">
                  {plan.priceNumber}
                </span>
                <span class="text-sm font-medium text-content-secondary ml-1">
                  {plan.periodDisplay}
                </span>
              </div>
              {plan.trialNote ? (
                <p class="text-xs font-medium text-content-secondary mt-1.5">
                  {plan.trialNote}
                </p>
              ) : (
                <p class="text-xs font-medium text-content-secondary mt-1.5 opacity-0">
                  &nbsp;
                </p>
              )}
            </div>

            <ul class="space-y-3 mb-8">
              {plan.featureItems.map((item) => (
                <li class={`flex items-start text-xs sm:text-sm ${item.included ? 'text-content-primary font-medium' : 'text-content-muted'}`}>
                  {item.included ? (
                    <svg class="w-4 h-4 text-spendly-600 mr-2.5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  ) : (
                    <span class="w-4 h-4 mr-2.5 shrink-0 text-center font-bold text-content-muted mt-0.5 leading-none">—</span>
                  )}
                  <span>{item.text}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="space-y-2.5 pt-4 border-t border-surface-borderSubtle">
            {plan.id === 'gratis' ? (
              <div class="space-y-2">
                <Button
                  href={registerUrl}
                  variant="secondary"
                  size="lg"
                  class="w-full text-center border-spendly-200 hover:border-spendly-400"
                >
                  Comenzar Gratis
                </Button>
                <p class="text-xs text-center text-spendly-700 font-semibold py-1">
                  Es tu plan inicial sin costo
                </p>
              </div>
            ) : (
              <div class="space-y-2.5">
                <a
                  href={registerUrl}
                  class="w-full text-center py-3 px-4 rounded-xl text-sm font-semibold text-white bg-spendly-700 hover:bg-spendly-800 transition-colors block shadow-soft"
                >
                  Probar Pro 3 días gratis
                </a>
                <a
                  href={registerUrl}
                  class="w-full text-center py-2.5 px-4 rounded-xl text-sm font-medium text-content-primary border border-surface-border hover:bg-surface-cardSubtle flex items-center justify-center gap-2 transition-colors"
                >
                  <svg class="w-4 h-4 text-content-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  </svg>
                  <span>Contratar Pro</span>
                </a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/planes"
        class="inline-flex items-center text-sm font-semibold text-spendly-700 hover:text-spendly-800 transition-colors gap-1.5"
      >
        <span>Ver tabla comparativa detallada de características</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
