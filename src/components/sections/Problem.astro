---
import SectionTitle from '../ui/SectionTitle.astro';

const problems = [
  {
    title: 'Gastos difíciles de seguir',
    description: 'Pequeñas compras cotidianas e imprevistos que van drenando tu saldo sin que recuerdes en qué se fueron.',
    icon: 'SearchX',
  },
  {
    title: 'Varias cuentas desordenadas',
    description: 'Efectivo en mano, dos tarjetas bancarias y billeteras digitales sin un total consolidado claro.',
    icon: 'Layers',
  },
  {
    title: 'Presupuestos que pierdes de vista',
    description: 'Límites mentales de gasto que se olvidan a mitad de mes, provocando excesos imprevistos a fin de periodo.',
    icon: 'ClockAlert',
  },
  {
    title: 'Metas sin progreso claro',
    description: 'Objetivos de ahorro sin metas definidas ni registro de aportes que terminan posponiéndose indefinidamente.',
    icon: 'TargetOff',
  },
];
---

<section class="py-16 sm:py-24 bg-surface-bg">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle
      badge="El Desafío Diario"
      title="¿A dónde se está yendo tu dinero?"
      subtitle="Entre cuentas, compras, pagos y gastos del día a día, mantener todo organizado puede convertirse en un desafío."
      align="center"
    />

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {problems.map((p) => (
        <div class="spendly-card p-6 bg-white flex flex-col justify-between border-surface-border">
          <div>
            <div class="w-11 h-11 rounded-xl bg-spendly-50 text-spendly-700 flex items-center justify-center mb-4 border border-spendly-100">
              {p.icon === 'SearchX' && (
                <svg class="w-5 h-5 text-spendly-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 11l-4-4m0 4l4-4" />
                </svg>
              )}
              {p.icon === 'Layers' && (
                <svg class="w-5 h-5 text-spendly-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              )}
              {p.icon === 'ClockAlert' && (
                <svg class="w-5 h-5 text-spendly-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
              {p.icon === 'TargetOff' && (
                <svg class="w-5 h-5 text-spendly-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
            </div>

            <h3 class="text-lg font-bold text-content-primary mb-2">
              {p.title}
            </h3>

            <p class="text-sm text-content-secondary leading-relaxed">
              {p.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
