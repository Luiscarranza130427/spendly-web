---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import { getAppUrl } from '../../data/navigation';

const registerUrl = getAppUrl('registro');
---

<section class="py-16 sm:py-24 bg-white border-y border-surface-border">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Columna Texto -->
      <div class="lg:col-span-6 flex flex-col items-start">
        <div class="mb-4">
          <Badge variant="mint">La Solución Spendly</Badge>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-content-primary leading-[1.18]">
          Tus finanzas,<br />
          <span class="spendly-gradient-text">más claras que nunca.</span>
        </h2>

        <p class="mt-6 text-base sm:text-lg text-content-secondary leading-relaxed">
          Spendly reúne tus cuentas, movimientos, presupuestos y objetivos en una experiencia simple y visual diseñada para darte tranquilidad mental.
        </p>

        <div class="mt-8 space-y-4">
          <div class="flex items-start gap-3.5">
            <div class="w-6 h-6 rounded-full bg-spendly-100 text-spendly-700 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <p class="text-sm sm:text-base font-semibold text-content-primary">Claridad inmediata</p>
              <p class="text-xs sm:text-sm text-content-secondary">Conoce tu saldo disponible real en cualquier momento sin hacer cálculos manuales.</p>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="w-6 h-6 rounded-full bg-spendly-100 text-spendly-700 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <p class="text-sm sm:text-base font-semibold text-content-primary">Decisiones con confianza</p>
              <p class="text-xs sm:text-sm text-content-secondary">Planifica gastos futuros sabiendo exactamente cuánto puedes comprometer hoy.</p>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-2">
          <Button href={registerUrl} size="md" variant="primary">
            Comenzar a ordenar mis finanzas
          </Button>
        </div>
      </div>

      <!-- Columna Visual: Demostración Interactiva -->
      <div class="lg:col-span-6 flex justify-center">
        <div class="relative w-full max-w-lg rounded-2xl sm:rounded-3xl p-3 bg-surface-cardSubtle border border-surface-border shadow-soft-lg group">
          <img
            src="/images/gifs/spendly-dashboard-live.gif"
            alt="Demostración dinámica de finanzas claras mostrando balance consolidado y movimientos en tiempo real en Spendly."
            width="800"
            height="450"
            class="w-full h-auto rounded-xl sm:rounded-2xl object-cover shadow-soft transition-transform duration-300 group-hover:scale-[1.01]"
            loading="lazy"
          />
          <div class="absolute bottom-6 right-6 bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-full border border-surface-border shadow-soft flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-spendly-500 animate-ping"></span>
            <span class="text-xs font-semibold text-content-primary">Balance en Tiempo Real</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
