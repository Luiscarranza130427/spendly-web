---
interface Props {
  title: string;
  description: string;
  tagline?: string;
  highlights?: string[];
  class?: string;
}

const {
  title,
  description,
  tagline,
  highlights = [],
  class: className = '',
} = Astro.props;
---

<div class={`spendly-card p-6 sm:p-7 flex flex-col justify-between ${className}`}>
  <div>
    <div class="w-12 h-12 rounded-xl bg-spendly-100 text-spendly-700 flex items-center justify-center mb-5 border border-spendly-200">
      <slot name="icon" />
    </div>

    {tagline && (
      <span class="text-xs font-semibold uppercase tracking-wider text-spendly-600 mb-1 block">
        {tagline}
      </span>
    )}

    <h3 class="text-xl font-bold text-content-primary tracking-tight mb-2.5">
      {title}
    </h3>

    <p class="text-content-secondary text-sm sm:text-base leading-relaxed">
      {description}
    </p>

    {highlights.length > 0 && (
      <ul class="mt-4 pt-4 border-t border-surface-borderSubtle space-y-2">
        {highlights.map((item) => (
          <li class="flex items-start text-xs sm:text-sm text-content-secondary">
            <svg class="w-4 h-4 text-spendly-500 mr-2 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="mt-4">
    <slot name="footer" />
  </div>
</div>
