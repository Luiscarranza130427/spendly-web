---
import { coreFeatures } from '../../data/features';
---

<div class="relative w-full overflow-hidden py-6" id="spendly-carousel-root">
  <!-- Contenedor del Carrusel -->
  <div class="relative max-w-5xl mx-auto px-4">
    <!-- Controles Superior: Indicadores y Botones Prev/Next -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-spendly-100 text-spendly-700 border border-spendly-200">
          Explorador Interactivo
        </span>
        <span class="text-xs text-content-secondary hidden sm:inline">
          Desliza o usa las flechas para descubrir cada herramienta
        </span>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="carousel-prev-btn"
          class="w-10 h-10 rounded-xl bg-white border border-surface-border text-content-primary hover:bg-spendly-50 hover:text-spendly-700 hover:border-spendly-300 flex items-center justify-center transition-all duration-200 shadow-soft-sm active:scale-95 focus-visible:ring-2 focus-visible:ring-spendly-500"
          aria-label="Función anterior"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          id="carousel-next-btn"
          class="w-10 h-10 rounded-xl bg-spendly-500 text-white hover:bg-spendly-600 flex items-center justify-center transition-all duration-200 shadow-soft active:scale-95 focus-visible:ring-2 focus-visible:ring-spendly-500"
          aria-label="Siguiente función"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Pista de Slides -->
    <div class="overflow-hidden rounded-3xl border border-surface-border bg-white shadow-soft-xl">
      <div id="carousel-track" class="flex transition-transform duration-500 ease-out">
        {coreFeatures.map((feat, idx) => (
          <div class="w-full flex-shrink-0 p-6 sm:p-10 lg:p-12" data-slide-index={idx}>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
              <!-- Información de la Función -->
              <div class="lg:col-span-6 flex flex-col items-start order-2 lg:order-1">
                <span class="text-xs font-bold uppercase tracking-wider text-spendly-700 bg-spendly-50 px-3 py-1 rounded-full border border-spendly-200 mb-3">
                  0{idx + 1} — {feat.title}
                </span>

                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-content-primary tracking-tight leading-snug">
                  {feat.tagline}
                </h3>

                <p class="mt-4 text-base text-content-secondary leading-relaxed">
                  {feat.description}
                </p>

                <!-- Beneficio clave -->
                <div class="mt-6 p-4 rounded-xl bg-surface-cardSubtle border border-surface-border w-full">
                  <p class="text-xs font-bold uppercase tracking-wider text-spendly-700 mb-1">
                    ¿Por qué te ayuda?
                  </p>
                  <p class="text-sm text-content-primary font-medium">
                    {feat.benefit}
                  </p>
                </div>

                <!-- Lista de puntos -->
                <ul class="mt-5 space-y-2 w-full">
                  {feat.highlights.map((h) => (
                    <li class="flex items-start text-xs sm:text-sm text-content-secondary">
                      <svg class="w-4 h-4 text-spendly-500 mr-2 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-6 pt-2">
                  <a
                    href={`/funciones#${feat.id}`}
                    class="inline-flex items-center text-sm font-semibold text-spendly-600 hover:text-spendly-700 gap-1.5 transition-colors group"
                  >
                    <span>Ver detalle completo</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Ilustración 3D de la Función con Contenedor Glass -->
              <div class="lg:col-span-6 flex justify-center order-1 lg:order-2">
                <div class="w-full max-w-md rounded-2xl sm:rounded-3xl p-3 bg-surface-cardSubtle border border-surface-border shadow-soft-lg transform transition-transform duration-300 hover:scale-[1.02]">
                  <img
                    src={feat.assetPath || '/images/illustrations/hero-fintech.png'}
                    alt={`Ilustración 3D de ${feat.title}`}
                    width="520"
                    height="390"
                    class="w-full h-auto rounded-xl sm:rounded-2xl object-cover"
                    loading="lazy"
                  />
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Indicadores de Puntos (Dots con tamaño táctil accesible mínimo 32x32px) -->
    <div class="flex justify-center items-center gap-1 mt-6" id="carousel-dots">
      {coreFeatures.map((_, idx) => (
        <button
          type="button"
          class="carousel-dot p-2 min-w-[32px] min-h-[32px] inline-flex items-center justify-center rounded-full focus-visible:outline-spendly-500"
          data-target-index={idx}
          aria-label={`Ir a diapositiva ${idx + 1}`}
        >
          <span
            class={`carousel-dot-indicator h-2.5 rounded-full transition-all duration-300 ${
              idx === 0 ? 'bg-spendly-600 w-8' : 'bg-surface-border w-2.5 hover:bg-spendly-400'
            }`}
          />
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  function initFeaturesCarousel() {
    const root = document.getElementById('spendly-carousel-root');
    if (!root) return;

    const track = document.getElementById('carousel-track') as HTMLElement | null;
    const prevBtn = document.getElementById('carousel-prev-btn');
    const nextBtn = document.getElementById('carousel-next-btn');
    const dots = root.querySelectorAll<HTMLButtonElement>('.carousel-dot');
    const slides = root.querySelectorAll('[data-slide-index]');

    if (!track || !prevBtn || !nextBtn || slides.length === 0) return;

    let currentIndex = 0;
    const totalSlides = slides.length;
    let autoplayTimer: number | null = null;

    function goToSlide(index: number) {
      if (!track) return;
      if (index < 0) {
        currentIndex = totalSlides - 1;
      } else if (index >= totalSlides) {
        currentIndex = 0;
      } else {
        currentIndex = index;
      }

      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      // Actualizar dots
      dots.forEach((dot, idx) => {
        const indicator = dot.querySelector('.carousel-dot-indicator');
        if (!indicator) return;
        if (idx === currentIndex) {
          indicator.classList.add('bg-spendly-600', 'w-8');
          indicator.classList.remove('bg-surface-border', 'w-2.5');
        } else {
          indicator.classList.remove('bg-spendly-600', 'w-8');
          indicator.classList.add('bg-surface-border', 'w-2.5');
        }
      });
    }

    prevBtn.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
      resetAutoplay();
    });

    nextBtn.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
      resetAutoplay();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const target = parseInt(dot.getAttribute('data-target-index') || '0', 10);
        goToSlide(target);
        resetAutoplay();
      });
    });

    // Soporte táctil swipe
    let touchStartX = 0;
    let touchEndX = 0;

    track.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const threshold = 50;
      if (touchEndX < touchStartX - threshold) {
        goToSlide(currentIndex + 1);
        resetAutoplay();
      } else if (touchEndX > touchStartX + threshold) {
        goToSlide(currentIndex - 1);
        resetAutoplay();
      }
    }

    // Autoplay suave cada 7 segundos si el usuario no tiene reducida la animación
    function startAutoplay() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      autoplayTimer = window.setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 7000);
    }

    function resetAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        startAutoplay();
      }
    }

    startAutoplay();
  }

  initFeaturesCarousel();
  document.addEventListener('astro:page-load', initFeaturesCarousel);
</script>
